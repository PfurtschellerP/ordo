# Dex (https://dexidp.io), the login of ORDO (ADR-0038, ADR-0039).
# Copy to dex.yaml. Domain and client secret come from .env; only the accounts below (or
# the connector to your organisation's provider) are yours to fill in.
issuer: https://{{ getenv "ORDO_DOMAIN" }}/dex

storage:
  type: sqlite3
  config:
    file: /var/dex/dex.db

web:
  http: 0.0.0.0:5556

# The API through which ORDO manages local accounts (ADR-0060). Only on the internal
# network, and only for clients with a certificate of this installation's CA.
grpc:
  addr: 0.0.0.0:5557
  tlsCert: /etc/dex/api/dex.pem
  tlsKey: /etc/dex/api/dex-key.pem
  tlsClientCA: /etc/dex/api/ca.pem

oauth2:
  skipApprovalScreen: true
  grantTypes:
    - "authorization_code"
    - "urn:ietf:params:oauth:grant-type:device_code"   # pairing tablets by QR code
  responseTypes: ["code"]

staticClients:
  - id: ordo
    name: ORDO
    secretEnv: ORDO_OIDC_CLIENT_SECRET
    redirectURIs:
      - "https://{{ getenv "ORDO_DOMAIN" }}/auth/callback"
      - "/dex/device/callback"

# Local accounts: administrators create, reset and delete them in ORDO (Organisation –
# Konten, ADR-0060). Roles are given in ORDO, not by groups (ADR-0046).
enablePasswordDB: true
# Accounts can also be written here; ORDO lists them but cannot change them.
#   Password hash:  docker run --rm httpd:2-alpine htpasswd -nbBC 10 "" 'the password' | tr -d ':\n'
#   User ID:        any random UUID, e.g. from  uuidgen
# staticPasswords:
#   - email: "anna@ordo.example.org"
#     hash: "replace with a bcrypt hash"
#     username: "Anna Schmidt"
#     preferredUsername: "anna"
#     userID: "replace with a random UUID"

# Everyone else: connect your organisation's OpenID Connect provider instead of (or
# besides) local accounts.
# connectors:
#   - type: oidc
#     id: organisation
#     name: "Login with your organisation"
#     config:
#       issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
#       clientID: <client id at your provider>
#       clientSecret: $ORGANISATION_CLIENT_SECRET
#       redirectURI: https://ordo.example.org/dex/callback
#       insecureEnableGroups: true
#       scopes: [openid, profile, email, groups]
