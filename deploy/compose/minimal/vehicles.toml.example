# The organisation's vehicles (master data, UNIT-1): offered when the incident command
# adds a unit, which then gets type, organisation, service and default strength filled in.
# Units not listed here can always be added by hand. To use it, mount it in a
# compose.override.yaml:
#   services:
#     ordo:
#       environment: { ORDO_VEHICLES_FILE: /config/vehicles.toml }
#       volumes: ["./vehicles.toml:/config/vehicles.toml:ro"]
# Services come from the profile (DE: fire, rescue, medical, civil-protection, civil-defence,
# thw, police);
# strength is leaders (Führer), sub-leaders (Unterführer), crew (Mannschaft).

[[vehicle]]
unit = "Rotkreuz Musterstadt 83/1"
type = "RTW"
organisation = "DRK Musterstadt"
service = "rescue"
strength = [0, 1, 1]

[[vehicle]]
unit = "Florian Musterstadt 1/46/1"
type = "HLF 20"
organisation = "FF Musterstadt"
service = "fire"
strength = [0, 1, 8]
