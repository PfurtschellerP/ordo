# Domain under which ORDO is reachable; also used as the ORDO server name.
# Use "localhost" to try it on your own machine.
ORDO_DOMAIN=ordo.example.org

# Login with OpenID Connect (ADR-0038). Leave empty to pair devices from seed.toml only.
# With the bundled Dex (docker compose --profile login up -d):
#   ORDO_OIDC_ISSUER=https://ordo.example.org/dex
# With your organisation's identity provider: its issuer URL, and ORDO's client ID there.
ORDO_OIDC_ISSUER=
ORDO_OIDC_CLIENT_ID=ordo
