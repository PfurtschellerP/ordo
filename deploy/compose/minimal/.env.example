# Domain under which ORDO is reachable; also the ORDO server name. On a field server
# without internet: a domain you obtained a certificate for beforehand (see README).
# Use "localhost" to try it on your own machine.
ORDO_DOMAIN=ordo.example.org

# Shared secret between ORDO and Dex. Create one with:  openssl rand -hex 32
ORDO_OIDC_CLIENT_SECRET=

# How long a device login lasts without re-verification by the identity provider, in
# hours: default 48; 24 to 720 (1 to 30 days) for long deployments without internet.
ORDO_ACCESS_TIMEOUT_HOURS=48
