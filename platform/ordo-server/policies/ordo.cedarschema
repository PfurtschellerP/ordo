// ORDO authorisation schema (ADR-0035). Packages and organisations write Cedar policies
// against it; the server validates every policy against it when it starts.
//
// Principal: a user. Resource: a data compartment of an incident, e.g.
// Compartment::"med.clinical". Context: the roles the user holds — organisation roles
// plus the roles granted in this incident (ADR-0046) — and the incident ID. People never
// get permissions directly; roles do.

entity User;
entity Compartment;

type Request = {
  roles: Set<String>,
  incident: String,
  // The module of the event being written, e.g. "units"; empty for reading and for the
  // view permissions.
  module: String,
  // The type of the event being written, e.g. "orders.given"; empty like `module`.
  event_type: String,
};

action read, write appliesTo {
  principal: [User],
  resource: [Compartment],
  context: Request,
};

// Views and functions of the app in an incident (resource: Compartment::"incident"); the
// server tells each device which of them the user's roles allow.
//   view_situation: the incident command's situation view (counts per UHS, units, roster)
//   edit_units: add units and set their status
//   give_orders: give medical orders (the server still checks every `orders.given`)
//   all_uhs: work at every on-site care unit, whatever its staff list (ADR-0056)
//   manage_map: cut the incident's map region (MAP-8, ADR-0062)
//   block_devices: see and block the devices used in the incident (ORG-12)
action view_situation, edit_units, give_orders, all_uhs, manage_map, block_devices appliesTo {
  principal: [User],
  resource: [Compartment],
  context: Request,
};

// Grant and withdraw roles in an incident and change its state (resource: the incident's
// Compartment::"incident").
action assign_role appliesTo {
  principal: [User],
  resource: [Compartment],
  context: Request,
};

// Organisation-wide actions: not tied to an incident.
entity Organisation;

type OrganisationRequest = {
  roles: Set<String>,
};

// See and revoke the devices of everyone (everyone may manage their own devices).
action manage_devices appliesTo {
  principal: [User],
  resource: [Organisation],
  context: OrganisationRequest,
};

// Plan incidents, see all of them, and grant roles in every incident (ADR-0046).
action manage_incidents appliesTo {
  principal: [User],
  resource: [Organisation],
  context: OrganisationRequest,
};

// Grant and withdraw organisation roles (ORG-9).
action manage_roles appliesTo {
  principal: [User],
  resource: [Organisation],
  context: OrganisationRequest,
};

// Create, reset and delete local login accounts in Dex (ORG-10, ADR-0060).
action manage_accounts appliesTo {
  principal: [User],
  resource: [Organisation],
  context: OrganisationRequest,
};
