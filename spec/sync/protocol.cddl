; ORDO sync protocol — draft 1, version 1.2
;
; Messages between devices and the server, CBOR-encoded (RFC 8949). Enums use the
; externally tagged form { "name": content }. Event structures: event.cddl.
; Prose: protocol.md.

; ---------------------------------------------------------------- device → server

client-message = { "hello": hello }
               / { "push": [* signed-event] }
               / "listDevices"                ; own devices, all with manage_devices
               / { "revokeDevice": device-id } ; own device, any with manage_devices
               / "listIncidents"              ; incidents with a role; all for planners
               / "listPeople"                 ; people to suggest when granting roles
               / "listVehicles"               ; vehicles of the installation (1.1)
               / "getMapRegion"               ; state of the map region (1.2)
               / { "cutMapRegion": map-region-request } ; with manage_map (1.2)
               / { "blobTicket": blob-request } ; attachments (ADR-0033)
               / { "getAvatars": [* user-id] }
               / { "setAvatar": { ? "image": bstr .size (0..131072) } } ; none: remove
               / { "setName": tstr / null }   ; own display name, null clears it (1.2)

hello = {
  "user": user-id,
  "device": device-id,
  "subscriptions": [* subscription],
  ; Ed25519 signature with the device key over
  ;   "ORDO hello v1" 0x00 || challenge nonce (32) || device-id (16) || UTF-8 user-id
  "proof": bstr .size 64,
  ? "version": version,          ; protocol version spoken; none means "1.0" (§11)
}

; A vehicle of the installation's master data (UNIT-1).
vehicle = {
  "unit": tstr,                    ; call sign
  "type": tstr,                    ; e.g. "RTW"
  "organisation": tstr,
  ? "service": tstr,               ; service ID from the profile
  ? "strength": [uint, uint, uint], ; leaders, sub-leaders, crew
}

; "major.minor", e.g. "1.4" (ADR-0052)
version = tstr .regexp "[0-9]+\\.[0-9]+"
version-range = { "min": version, "max": version }

subscription = {
  "incident": incident-id,
  "compartment": compartment-id,
  "after": uint,                 ; last sequence number the device has, 0 if none
}

; ---------------------------------------------------------------- server → device

server-message = { "challenge": challenge }
               / { "welcome": welcome }
               / { "refused": rejection }
               / { "deliver": delivery }
               / { "rejected": rejected }
               / { "devices": [* device-info] } ; answer to listDevices and revokeDevice
               / { "incidents": [* incident-summary] } ; answer to listIncidents
               / { "people": [* user-id] }    ; answer to listPeople; empty unless the
                                              ; user may grant roles somewhere
               / { "vehicles": [* vehicle] }  ; answer to listVehicles (1.1); empty unless
                                              ; the user may edit units somewhere
               / { "mapRegion": map-region }  ; answer to getMapRegion and cutMapRegion
                                              ; (1.2); state "none" without manage_map
               / { "avatars": [* avatar] }    ; answer to getAvatars and setAvatar
               / { "blobTicket": blob-ticket } ; answer to blobTicket

; First message on every connection; the hello must sign the nonce.
challenge = {
  "nonce": bstr .size 32,          ; random, used once
  ? "versions": version-range,     ; protocol versions the server supports (§11)
}

welcome = {
  "granted": [* subscription],
  "denied": [* stream-ref],
  "protected": [* compartment-id],
  "keys": [* key-grant],
  ? "permissions": [* tstr],       ; beyond compartments, e.g. "manage_devices"
  ? "incident_permissions": [* { "incident": incident-id, "permissions": [* tstr] }],
                                   ; views per incident, e.g. "view_situation"
  ? "valid_until": uint,           ; end of this device's login (ms since 1970); the
                                   ; device locks itself afterwards, also offline
  ? "version": version,            ; protocol version agreed for this connection
}

device-info = {
  "device": device-id,
  "user": user-id,
  ? "paired": uint,                ; when it was paired (ms since 1970)
  ? "valid_until": uint,           ; end of its login (ms since 1970)
  ? "name": tstr,                  ; as chosen at pairing, e.g. "Firefox auf Android" (1.2)
}

; Attachments: encrypted on the device, named by the BLAKE3 hash of the ciphertext.
blob-request = {
  "incident": incident-id,
  "compartment": compartment-id,   ; of the event that refers to the attachment
  "hash": bstr .size 32,
  "size": uint,                    ; bytes, for uploads
  "upload": bool,
}

; A ticket for PUT / GET /blobs/<hex hash> with "Authorization: Bearer <ticket>";
; absent if not allowed. Valid ten minutes; upload tickets once.
blob-ticket = {
  "hash": bstr .size 32,
  "upload": bool,
  ? "ticket": tstr,
}

; Profile picture, resolved by the server: uploaded in ORDO, else the identity provider's
; picture, else Gravatar (ADR-0047). JPEG, PNG or WebP.
avatar = {
  "user": user-id,
  ? "image": bstr,
  ? "name": tstr,                  ; display name (ORG-7, 1.2)
}

incident-summary = {
  "incident": incident-id,
  "name": tstr,
  "state": "planned" / "active" / "closed",
  "roles": [* tstr],               ; the person's roles in it
  "manage": bool,                  ; may grant roles and change the state
}

stream-ref = {
  "incident": incident-id,
  "compartment": compartment-id,
}

; Draft 0: the key travels inside the TLS-protected session. Draft 1 encrypts it for
; the device's own X25519 key.
key-grant = {
  "incident": incident-id,
  "compartment": compartment-id,
  "key_id": key-id,
  "key": bstr .size 32,
}

delivery = {
  "incident": incident-id,
  "compartment": compartment-id,
  "events": [* sequenced-event],   ; consecutive sequence numbers, ascending
}

rejected = {
  "event": event-id,
  "reason": rejection,
}

rejection = "malformed" / "unknownDevice" / "notAuthenticated" / "loginExpired"
          / "revoked" / "rolesChanged"
          / "wrongAuthor" / "badSignature"
          / "forbidden" / "wrongSealing" / "clockAhead" / "notConnected"
          / "duplicateId" / "unsupportedVersion"

; The map region the server offers its devices (MAP-8): cut from a world map around a centre.
map-region-request = {
  "latE7": int,                    ; centre, WGS 84, degrees × 10^7 (as in PMTiles)
  "lonE7": int,
  "radiusM": uint,                 ; metres, 1000 to 50000
}

map-region = {
  "state": "none" / "running" / "ready" / "failed",
  ? "done": uint,                  ; tiles fetched (running)
  ? "total": uint,                 ; tiles to fetch (running)
  ? "bytes": uint,                 ; size of the region file (ready)
  ? "area": map-region-request,    ; the region's centre and radius (running, ready)
  ? "at": uint,                    ; when it was cut, ms since the Unix epoch (ready)
  ? "error": tstr,                 ; why it failed (failed)
}
