; ORDO sync protocol — draft 1, version 1.2
;
; Messages between devices and the server, CBOR-encoded (RFC 8949). Enums use the
; externally tagged form { "name": content }. Event structures: event.cddl.
; Prose: protocol.md.

; ---------------------------------------------------------------- device → server

client-message = { "hello": hello }
               / { "push": [* signed-event] }
               / "listDevices"                ; own devices, all with manage_devices
               / { "revokeDevice": device-id } ; own device, any with manage_devices
               / { "listIncidentDevices": incident-id } ; devices of the incident's
                                              ; people, with block_devices there (1.2)
               / { "blockDevice": device-block } ; revoke one of them (1.2)
               / "listIncidents"              ; incidents with a role; all for planners
               / "listPeople"                 ; people to suggest when granting roles
               / "listVehicles"               ; vehicles of the installation (1.1)
               / { "getMapRegion": incident-id } ; state of the incident's map region (1.2)
               / { "cutMapRegion": map-region-cut } ; with manage_map in the incident (1.2)
               / { "mapTicket": incident-id } ; ticket to read the incident's map region (1.2)
               / { "geocode": geocode-request } ; address search, with manage_map or
                                              ; edit_units in the incident (1.2)
               / { "blobTicket": blob-request } ; attachments (ADR-0033)
               / { "getAvatars": [* user-id] }
               / { "setAvatar": { ? "image": bstr .size (0..131072) } } ; none: remove
               / { "setName": tstr / null }   ; own display name, null clears it (1.2)
               / "getOrganisationRoles"       ; with manage_roles (1.2)
               / { "setOrganisationRole": organisation-role-change } ; with manage_roles (1.2)
               / "getAccounts"                ; with manage_accounts (1.2)
               / { "changeAccount": account-change } ; with manage_accounts (1.2)
               / "getLoginProviders"          ; with manage_accounts (1.2)
               / { "testLoginProvider": login-provider-draft } ; with manage_accounts (1.2)
               / { "saveLoginProvider": tstr } ; a passed test's token (1.2)
               / { "deleteLoginProvider": tstr } ; a provider's ID (1.2)
               / "ping"                       ; is the line alive? (1.2)

hello = {
  "user": user-id,
  "device": device-id,
  "subscriptions": [* subscription],
  ; Ed25519 signature with the device key over
  ;   "ORDO hello v1" 0x00 || challenge nonce (32) || device-id (16) || UTF-8 user-id
  "proof": bstr .size 64,
  ? "version": version,          ; protocol version spoken; none means "1.0" (§11)
}

; A vehicle of the installation's master data (UNIT-1).
vehicle = {
  "unit": tstr,                    ; call sign
  "type": tstr,                    ; e.g. "RTW"
  "organisation": tstr,
  ? "service": tstr,               ; service ID from the profile
  ? "strength": [uint, uint, uint], ; leaders, sub-leaders, crew
}

; "major.minor", e.g. "1.4" (ADR-0052)
version = tstr .regexp "[0-9]+\\.[0-9]+"
version-range = { "min": version, "max": version }

subscription = {
  "incident": incident-id,
  "compartment": compartment-id,
  "after": uint,                 ; last sequence number the device has, 0 if none
}

; ---------------------------------------------------------------- server → device

server-message = { "challenge": challenge }
               / { "welcome": welcome }
               / { "refused": rejection }
               / { "deliver": delivery }
               / { "rejected": rejected }
               / { "devices": [* device-info] } ; answer to listDevices and revokeDevice
               / { "incidentDevices": incident-devices } ; answer to listIncidentDevices
                                              ; and blockDevice (1.2)
               / { "incidents": [* incident-summary] } ; answer to listIncidents
               / { "people": [* user-id] }    ; answer to listPeople; empty unless the
                                              ; user may grant roles somewhere
               / { "vehicles": [* vehicle] }  ; answer to listVehicles (1.1); empty unless
                                              ; the user may edit units somewhere
               / { "mapRegion": map-region }  ; answer to getMapRegion and cutMapRegion
                                              ; (1.2); state "none" without manage_map
               / { "mapTicket": map-ticket }  ; answer to mapTicket (1.2)
               / { "geocoded": geocoded }     ; answer to geocode (1.2)
               / { "avatars": [* avatar] }    ; answer to getAvatars and setAvatar
               / { "organisationRoles": [* organisation-role] } ; answer to
                                              ; getOrganisationRoles and setOrganisationRole
                                              ; (1.2); empty without manage_roles
               / { "accounts": accounts }     ; answer to getAccounts and changeAccount (1.2)
               / { "loginProviders": login-providers } ; answer to the login provider
                                              ; messages (1.2)
               / { "blobTicket": blob-ticket } ; answer to blobTicket
               / "pong"                       ; answer to ping (1.2)

; First message on every connection; the hello must sign the nonce.
challenge = {
  "nonce": bstr .size 32,          ; random, used once
  ? "versions": version-range,     ; protocol versions the server supports (§11)
}

welcome = {
  "granted": [* subscription],
  "denied": [* stream-ref],
  "protected": [* compartment-id],
  "keys": [* key-grant],
  ? "permissions": [* tstr],       ; beyond compartments, e.g. "manage_devices"
  ? "incident_permissions": [* { "incident": incident-id, "permissions": [* tstr] }],
                                   ; views per incident, e.g. "view_situation"
  ? "valid_until": uint,           ; end of this device's login (ms since 1970); the
                                   ; device locks itself afterwards, also offline
  ? "version": version,            ; protocol version agreed for this connection
}

device-info = {
  "device": device-id,
  "user": user-id,
  ? "paired": uint,                ; when it was paired (ms since 1970)
  ? "valid_until": uint,           ; end of its login (ms since 1970)
  ? "name": tstr,                  ; as chosen at pairing, e.g. "Firefox auf Android" (1.2)
  ? "connected": bool,             ; has an open connection now (1.2); absent: false
}

; The devices used in an incident (ORG-12): those of everyone with a role there.
incident-devices = {
  "incident": incident-id,
  "devices": [* device-info],      ; empty without block_devices in the incident
}

device-block = {
  "incident": incident-id,
  "device": device-id,
}

; Organisation roles (ORG-9): "admin", "planner".
organisation-role = {
  "user": user-id,
  "role": tstr,
  ? "valid_until": uint,           ; counts until then (ms since 1970); none: no end
  ? "fixed": bool,                 ; from the server's configuration, not changeable
}

organisation-role-change = {
  "user": user-id,
  "role": "admin" / "planner",
  "grant": bool,                   ; false withdraws
  ? "valid_until": uint,           ; with grant: counts until then (ms since 1970)
}

; Local login accounts in Dex (ORG-10). Passwords: 12 characters to 72 bytes; the server
; hashes them with bcrypt for Dex and does not keep them.
account = { "email": tstr, "name": tstr }

account-change = { "create": { "email": tstr, "name": tstr, "password": tstr } }
               / { "setPassword": { "email": tstr, "password": tstr } }
               / { "delete": { "email": tstr } }

accounts = {
  "managed": bool,                 ; false without manage_accounts or without Dex's API
  ? "list": [* account],
  ? "error": "invalid" / "passwordLength" / "exists" / "notFound" / "refused" / "unreachable",
}

; Upstream login providers (ORG-11, ADR-0063): OpenID Connect connectors of Dex, saved
; only after a test login through them. Secrets are never sent to the device.
login-provider-draft = {
  ? "id": tstr,                    ; the provider being changed
  "name": tstr,
  "issuer": tstr,                  ; http(s) URL
  "clientId": tstr,
  ? "clientSecret": tstr,          ; none: keep the old one (changing only)
  ? "skipEmailVerified": bool,
}

login-provider = {
  "id": tstr,
  "name": tstr,
  "kind": tstr,                    ; e.g. "oidc", "local", "ldap"
  ? "issuer": tstr,
  ? "clientId": tstr,
  ? "skipEmailVerified": bool,
  "editable": bool,                ; OpenID Connect, not the local accounts
}

login-test-state = "waiting"
                 / { "passed": { "user": tstr, ? "name": tstr, ? "email": tstr } }
                 / { "failed": tstr }

login-providers = {
  "managed": bool,                 ; false without manage_accounts or without Dex's API
  ? "redirectUri": tstr,           ; to register at a provider
  ? "list": [* login-provider],
  ? "test": {                      ; the user's running test login (10 minutes)
    "token": tstr,
    "url": tstr,                   ; /auth/test/<token>, to open in a new browser tab
    "name": tstr,
    "state": login-test-state,
  },
  ? "error": "invalid" / "notFound" / "notTested" / "refused" / "unreachable",
}

; Attachments: encrypted on the device, named by the BLAKE3 hash of the ciphertext.
blob-request = {
  "incident": incident-id,
  "compartment": compartment-id,   ; of the event that refers to the attachment
  "hash": bstr .size 32,
  "size": uint,                    ; bytes, for uploads
  "upload": bool,
}

; A ticket for PUT / GET /blobs/<hex hash> with "Authorization: Bearer <ticket>";
; absent if not allowed. Valid ten minutes; upload tickets once.
blob-ticket = {
  "hash": bstr .size 32,
  "upload": bool,
  ? "ticket": tstr,
}

; Profile picture, resolved by the server: uploaded in ORDO, else the identity provider's
; picture, else Gravatar (ADR-0047). JPEG, PNG or WebP.
avatar = {
  "user": user-id,
  ? "image": bstr,
  ? "name": tstr,                  ; display name (ORG-7, 1.2)
}

incident-summary = {
  "incident": incident-id,
  "name": tstr,
  "state": "planned" / "active" / "closed",
  ? "paused": bool,                ; a running incident paused (1.2), default false
  ? "startsAt": uint,              ; planned start, ms since the Unix epoch (1.2)
  "roles": [* tstr],               ; the person's roles in it
  "manage": bool,                  ; may grant roles and change the state
}

stream-ref = {
  "incident": incident-id,
  "compartment": compartment-id,
}

; Draft 0: the key travels inside the TLS-protected session. Draft 1 encrypts it for
; the device's own X25519 key.
key-grant = {
  "incident": incident-id,
  "compartment": compartment-id,
  "key_id": key-id,
  "key": bstr .size 32,
}

delivery = {
  "incident": incident-id,
  "compartment": compartment-id,
  "events": [* sequenced-event],   ; consecutive sequence numbers, ascending
}

rejected = {
  "event": event-id,
  "reason": rejection,
}

rejection = "malformed" / "unknownDevice" / "notAuthenticated" / "loginExpired"
          / "revoked" / "rolesChanged"
          / "wrongAuthor" / "badSignature"
          / "forbidden" / "wrongSealing" / "clockAhead" / "notConnected"
          / "duplicateId" / "unsupportedVersion"

; An incident's map region (MAP-8, ADR-0062): cut from a world map around a centre.
map-region-cut = {
  "incident": incident-id,
  "area": map-region-request,
}

; A ticket for GET /tiles/<incident ULID>.pmtiles with "Authorization: Bearer <ticket>";
; absent unless the user may read the incident's shared compartment. Valid 12 hours.
map-ticket = {
  "incident": incident-id,
  ? "ticket": tstr,
}

; An address search for an incident's map (ADR-0066). The server asks its geocoder
; (default: OpenStreetMap's Nominatim, at most one request per second, answers cached).
geocode-request = {
  "incident": incident-id,
  "query": tstr .size (1..200),    ; as typed
}

geocoded = {
  "query": tstr,                   ; the query as sent
  ? "status": "found" / "off" / "refused" / "failed", ; default "found"
  ? "places": [* geocoded-place],  ; best first, at most 5
}

geocoded-place = {
  "label": tstr,                   ; as the geocoder names the place
  "latE7": int,                    ; WGS 84, degrees × 10^7
  "lonE7": int,
}

map-region-request = {
  "latE7": int,                    ; centre, WGS 84, degrees × 10^7 (as in PMTiles)
  "lonE7": int,
  "radiusM": uint,                 ; metres, 1000 to 50000
}

map-region = {
  ? "incident": incident-id,       ; the incident asked about
  "state": "none" / "running" / "ready" / "failed",
  ? "done": uint,                  ; tiles fetched (running)
  ? "total": uint,                 ; tiles to fetch (running)
  ? "bytes": uint,                 ; size of the region file (ready)
  ? "area": map-region-request,    ; the region's centre and radius (running, ready)
  ? "at": uint,                    ; when it was cut, ms since the Unix epoch (ready)
  ? "error": tstr,                 ; why it failed (failed)
}
